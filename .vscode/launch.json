// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// Documentation:
// * https://code.visualstudio.com/docs/editor/debugging#_launch-configurations
// * https://github.com/golang/vscode-go/wiki/debugging#launchjson-attributes
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go Run",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "env": {
        "LIVEKIT_KEYS": "devkey: secret",
        "LIVEKIT_WEBHOOK_URLS": "http://localhost:8080/webhook",
      },
      "args": ["--dev"]
    },
    {
      "name": "Go Run (OpenVidu Local Deployment)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "env": {
        "LAN_MODE": "true",
        "LAN_PRIVATE_IP": "192.168.1.190",
        "NODE_IP": "192.168.1.190"
      },
      "args": [
        "--config",
        "${workspaceFolder}/.vscode/livekit-debug.yaml",
        "--node-ip",
        "192.168.1.190"
      ]
    }
  ]
}
