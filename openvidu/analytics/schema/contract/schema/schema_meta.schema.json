				},
				"updatedAt": { "bsonType": "date" }
			},
			"additionalProperties": false
		},
		{
			"bsonType": "object",
			"required": ["_id", "timeseries", "transactions", "serverVersion", "detectedAt"],
			"properties": {
				"_id": { "bsonType": "string", "enum": ["capabilities"] },
