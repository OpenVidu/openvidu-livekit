				"updatedAt": { "bsonType": "date" }
			},
			"additionalProperties": false
		},
		{
			"bsonType": "object",
			"required": [
				"_id",
				"eventsMs",
				"statsMs",
				"tracksMs",
				"entitiesMs",
				"rollupsHourlyMs",
				"rollupsDailyMs",
				"updatedAt"
			],
			"properties": {
